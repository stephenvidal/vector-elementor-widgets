            "intro": "A few helpful details before you visit. If your question is not here, just ask.",
            "items": [
              {
                "question": "When do you roast?",
                "answer": "We roast every Monday and bag beans the following day. The menu reflects this week's batch, so it's always fresh."
              },
              {
                "question": "Can I buy beans by the bag?",
                "answer": "Yes — all our roasts are available by the 12oz bag, in-store or to order ahead."
              },
              {
                "question": "Do you deliver beans?",
                "answer": "We offer local delivery within [Primary City] on bean orders over $25, and subscriptions ship nationwide."
              },
              {
                "question": "Do you offer subscriptions?",
                "answer": "Yes. Choose your roast and frequency, and we'll roast and ship it to you on a standing schedule. Pause or cancel anytime."
              },
              {
                "question": "Do you brew decaf?",
                "answer": "We do — our Swiss Water decaf is roasted and brewed with the same care as the rest of the line-up."
              },
              {
                "question": "Do you take wholesale accounts?",
                "answer": "Absolutely. For offices, cafés, and restaurants, get in touch and we'll set up a wholesale account and schedule."
              }
            ]
