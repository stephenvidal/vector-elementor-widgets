      "widgets": [
        {
          "type": "vew-faq",
          "settings": {
            "eyebrow": "Good to know",
            "title": "Questions,",
            "title_accent": "answered clearly.",
            "intro": "A few helpful details before you join. If your question is not here, just get in touch.",
            "items": [
              {
                "question": "Do I need experience to join?",
                "answer": "No. Every program is scaled to your level. Coaches meet you where you are and build you up from there."
              },
              {
                "question": "How big are the classes?",
                "answer": "Sessions are capped at 8 people. That cap is what lets coaches actually coach — every rep gets attention."
              },
              {
                "question": "What does the free first week include?",
                "answer": "Unlimited access to scheduled sessions for your first week, plus a baseline assessment and a program intro. No card required."
              },
              {
                "question": "Can I cancel anytime?",
                "answer": "Yes. There are no lock-in contracts. Annual and lifetime plans are one-time commitments you choose; monthly is month-to-month."
              },
              {
                "question": "What should I bring?",
                "answer": "Comfortable training clothes and water. We have all the equipment — barbells, kettlebells, rowers, and more."
              },
              {
                "question": "What if I miss a session?",
                "answer": "Your program is flexible. Missed sessions can be made up within the same week, subject to class availability."
              }
            ]
          }
        }
      ]
