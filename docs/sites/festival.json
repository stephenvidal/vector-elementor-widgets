            "eyebrow": "What to expect",
            "title": "More than a",
            "title_accent": "lineup",
            "intro": "We built Mmmetry around the moments between the sets — the ones you'll still be talking about in October.",
            "features": [
              { "number": "01", "title": "The Rail Yard stage", "text": "A converted warehouse floor with a Funktion-One rig that hits you in the chest. Headliners close the night here.", "detail": "Main stage" },
              { "number": "02", "title": "The Boiler Room", "text": "A sweaty, low-ceilinged room for techno and hard-hitting live sets. No phones, no photos — just the music.", "detail": "Intimate stage" },
              { "number": "03", "title": "The River Deck", "text": "Ambient and downtempo sets as the sun goes down over the water. Bring a blanket, stay for the sunset.", "detail": "Daytime stage" },
              { "number": "04", "title": "Live modular garden", "text": "An open-air patch bay where artists build sets in real time. Watch the cables, hear the sound evolve.", "detail": "Interactive" },
              { "number": "05", "title": "The Night Market", "text": "Local food trucks, a record fair, and a repair bench where you can fix your headphones between sets.", "detail": "Food & culture" },
              { "number": "06", "title": "Camping under the bridge", "text": "A quiet campsite a short walk from the gates, with showers, coffee at dawn, and a place to sleep it off.", "detail": "On-site camping" }
            ]
          }
        }
