        {
          "type": "vew-faq",
          "settings": {
            "eyebrow": "Good to know",
            "title": "Questions,",
            "title_accent": "answered clearly.",
            "intro": "A few helpful details before we start. If your question isn't here, just get in touch.",
            "items": [
              {
                "question": "How long does a website take?",
                "answer": "A typical project takes 2\u20134 weeks from our first call to launch. A simple one-pager can go faster; a larger site with many pages takes a little longer. You'll get a clear timeline up front."
              },
              {
                "question": "Do I need to write the content?",
                "answer": "I'll guide you with a simple content checklist. You know your business best, so you provide the facts and details \u2014 I handle the design, structure, and how it's presented."
              },
              {
                "question": "Will I be able to update it myself?",
                "answer": "Yes. The site is built with clean, straightforward structure, and I can show you how to make simple updates. For bigger changes, I'm a message away."
              },
              {
                "question": "Do you work with clients outside Myrtle Beach?",
                "answer": "Absolutely. I'm based in Myrtle Beach, SC, but I work with small businesses everywhere \u2014 all calls and collaboration happen online."
              },
              {
                "question": "What does \"design + build\" include?",
                "answer": "Every package includes custom design, a mobile-first build, and a live launch on fast, secure hosting. Copywriting, ongoing maintenance, and advanced features are quoted as add-ons."
              }
            ]
          }
        }
