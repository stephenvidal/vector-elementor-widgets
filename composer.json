{
  "name": "vector/vector-elementor-widgets",
  "description": "A reusable production UI component library for Elementor — the Derby-standard component system as native Elementor widgets.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "keywords": ["wordpress", "plugin", "elementor", "widgets", "components", "design-system"],
  "homepage": "https://vector.example",
  "authors": [
    {
      "name": "Stephen Vidal",
      "email": "stephen@example.invalid"
    }
  ],
  "require": {
    "php": ">=8.1",
    "composer/installers": "^2.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "wp-coding-standards/wpcs": "^3.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "squizlabs/php_codesniffer": "^3.7",
    "phpstan/phpstan": "^1.11",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "roave/security-advisories": "dev-latest",
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Vector\\ElementorWidgets\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Vector\\ElementorWidgets\\TestSupport\\": "tests/Support/",
      "Vector\\ElementorWidgets\\Tests\\Unit\\": "tests/Unit/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "composer/installers": true
    },
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "lint": "phpcs",
    "stan": "phpstan analyse",
    "test": "phpunit",
    "test-cov": "phpunit --coverage-html=reports/coverage",
    "all": [
      "@lint",
      "@stan",
      "@test"
    ]
  },
  "scripts-descriptions": {
    "lint": "Run WordPress Coding Standards (WPCS) checks.",
    "stan": "Run PHPStan static analysis.",
    "test": "Run PHPUnit unit tests.",
    "test-cov": "Run PHPUnit with HTML coverage report.",
    "all": "Run lint + stan + test."
  }
}
